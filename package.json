{
  "name": "youversion-suggest",
  "title": "YouVersion Bible Suggest",
  "description": "An API for searching the YouVersion Bible and fetching Bible content",
  "version": "4.0.1",
  "license": "MIT",
  "author": "Caleb Evans",
  "homepage": "https://github.com/caleb531/youversion-suggest-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caleb531/youversion-suggest-api.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "prepare": "rollup -c",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "tsc --noEmit; eslint 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "dependencies": {
    "@worker-tools/html-rewriter": "0.1.0-pre.19",
    "html-entities": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-dynamic-import-vars": "^2.1.5",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-wasm": "^6.2.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "rollup": "^4.68.7",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
  }
}
